# Nombre propio para no chocar con la versión anterior (contenedores park_plaza_*) ni con otros sistemas del servidor.
COMPOSE_PROJECT_NAME=parkplaza_v2

# Los dos sitios que crearás en aaPanel (sin https://). Ambos registros DNS (tipo A) apuntan a la IP del servidor.
# Sin dominio propio se puede usar sslip.io con la IP: erp.203.0.113.10.sslip.io y reservas.203.0.113.10.sslip.io
ERP_DOMAIN=parkplaza.grupoamayo.com
CUSTOMER_DOMAIN=cliente.parkplaza.grupoamayo.com

# Puertos internos (solo 127.0.0.1) a los que apunta el proxy inverso de cada sitio de aaPanel.
ERP_PORT=18081
CUSTOMER_PORT=18082

POSTGRES_USER=park_plaza
POSTGRES_PASSWORD=REEMPLAZAR_CON_CLAVE_ALEATORIA_DE_24_CARACTERES
POSTGRES_DB=park_plaza
# La misma clave de arriba. Si tiene símbolos reservados (@ : / ? #), codifícala para una URL.
DATABASE_URL=postgresql://park_plaza:REEMPLAZAR_CON_CLAVE_URL_ENCODED@postgres:5432/park_plaza

# Secretos: deploy/aapanel/instalar.sh los genera solo si este archivo no existe.
# DEMO_STAFF_PASSWORD es solo un respaldo interno: el personal entra con usuario = clave (superadmin/superadmin, recepcion/recepcion…).
JWT_SECRET=REEMPLAZAR_CON_SECRETO_ALEATORIO_DE_64_CARACTERES
DEMO_STAFF_PASSWORD=REEMPLAZAR_CON_CLAVE_TEMPORAL_SEGURA_DE_16_CARACTERES

# Facturación electrónica: "demo" genera XML, CDR y PDF sin enviar a SUNAT. Con el OSE/PSE del cliente: beta → production.
SUNAT_MODE=demo
SUNAT_ADAPTER_URL=
SUNAT_ADAPTER_TOKEN=
SUNAT_ADAPTER_TIMEOUT_MS=30000
SUNAT_INVOICE_SERIES=F001
SUNAT_RECEIPT_SERIES=B001

# 1 copia del servidor para 2 GB de RAM; 2 desde 4 GB.
BACKEND_REPLICAS=1
BACKUP_KEEP_DAYS=14
