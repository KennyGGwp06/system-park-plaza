{
  "name": "hotel-park-plaza-erp",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "customer",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace server\" \"npm run dev --workspace client\" \"npm run dev --workspace customer\"",
    "build": "npm run build --workspace client && npm run build --workspace customer",
    "install:all": "npm install",
    "db:migrate": "npm run migrate --workspace server -- up",
    "db:rollback": "npm run migrate --workspace server -- down",
    "db:limpiar-operacion": "node server/scripts/clean-operational-demo.js",
    "test:shift-ui": "node scripts/shift-ui-contract.mjs",
    "test:navigation": "node scripts/navigation-contract.mjs",
    "test:acceptance": "npm run test:navigation && npm run test:shift-ui && npm run test:access-contract --workspace client && npm run test:stock-requests --workspace server && npm run test:operational-inventory --workspace server && npm run test:order-inventory --workspace server && npm run test:phase2-operations --workspace server && npm run test:rbac-security --workspace server && npm run test:electronic-billing --workspace server && npm run test:realtime --workspace server",
    "test:inventory-phase1": "npm run test:inventory-phase1 --workspace server",
    "test:product-catalog": "npm run test:product-catalog --workspace server",
    "test:operational-inventory": "npm run test:operational-inventory --workspace server",
    "test:technical-recipes": "npm run test:technical-recipes --workspace server",
    "test:transformations": "npm run test:transformations --workspace server",
    "test:order-inventory": "npm run test:order-inventory --workspace server",
    "test:realtime": "npm run test:realtime --workspace server",
    "test:bar-bottles": "npm run test:bar-bottles --workspace server",
    "test:inventory-admin": "npm run test:inventory-admin --workspace server",
    "test:rbac-security": "npm run test:rbac-security --workspace server",
    "test:electronic-billing": "npm run test:electronic-billing --workspace server",
    "prod:preflight": "node scripts/production/preflight.mjs .env.production",
    "prod:config": "docker compose --env-file .env.production -f docker-compose.production.yml config --quiet",
    "prod:build": "docker compose --env-file .env.production -f docker-compose.production.yml build",
    "prueba:flujo-completo": "node scripts/pruebas/flujo-completo.cjs",
    "prueba:pantallas-dueno": "node scripts/pruebas/capturas-dueno.cjs",
    "prueba:estaciones": "node scripts/pruebas/estaciones.cjs",
    "prueba:tiempo-real": "node scripts/pruebas/tiempo-real.cjs",
    "prueba:lecturas": "node scripts/carga/recorrido-lecturas.mjs",
    "prueba:carga": "node scripts/carga/carga.mjs lectura 10",
    "demo:preparar": "node server/scripts/preparar-demo.mjs",
    "prueba:negocio": "node scripts/pruebas/recorrido-negocio.mjs",
    "prueba:botones": "node scripts/pruebas/botones.cjs",
    "aapanel:preflight": "node scripts/production/preflight.mjs .env.aapanel aapanel",
    "aapanel:up": "docker compose -f docker-compose.aapanel.yml --env-file .env.aapanel up -d --build",
    "test:catalog-bootstrap": "node server/scripts/catalog-bootstrap-test.js",
    "prueba:carta": "node scripts/pruebas/carta.cjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "puppeteer-core": "^25.13.0"
  },
  "overrides": {
    "qs": "^6.16.0",
    "@grpc/grpc-js": "^1.14.5"
  }
}
